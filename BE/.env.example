# Environment Variables

# App
PORT=3000
MONGODB_URI="mongodb://localhost:27017/OJT-KNS"
# Database
DB_USERNAME=DB_USERNAME
DB_PASSWORD=DB_PASSWORD

DB_PORT=3306

# JWT (dùng 2 secret khác nhau cho Access Token và Refresh Token)
JWT_SECRET=change_this_secret_key
JWT_REFRESH_SECRET=change_this_refresh_secret_key

# Token Lifetimes
ACCESS_TOKEN_EXPIRES_IN='number_of_'m
REFRESH_TOKEN_EXPIRES_IN='number_of_day'd

### AI
GOOGLE_API_KEYS=enter_your_api_key

# Tên model LLM của Google (ví dụ: gemini-flash-latest, gemma-4-31b-it)
GOOGLE_LLM_MODEL=gemma-4-31b-it

# (Tùy chọn) OpenAI API Key nếu sau này bạn muốn đổi model
# OPENAI_API_KEY=your_openai_api_key_here

# Cấu hình môi trường
ENVIRONMENT=development
AI_SERVICE_URL=http://localhost:8000
###
