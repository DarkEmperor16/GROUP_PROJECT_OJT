  "item": [
    {
      "name": "1. Teacher Courses",
      "item": [
        {
          "name": "List My Courses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/teacher/courses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "courses"]
            },
            "description": "Lay danh sach course duoc gan cho teacher hien tai."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.courses && data.courses.length > 0 && data.courses[0].id) {",
                  "  pm.collectionVariables.set('courseId', data.courses[0].id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List My Courses By Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/teacher/courses?status={{courseStatus}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "courses"],
              "query": [
